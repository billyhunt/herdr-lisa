{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.11"
  },
  "type": "column",
  "children": [
    {
      "id": "spectrum",
      "type": "row",
      "size": {
        "px": 16
      },
      "resizable": false,
      "window_drag": true,
      "children": [
        { "id": "spectrum-1", "type": "row", "children": [], "background": "fill_1" },
        { "id": "spectrum-2", "type": "row", "children": [], "background": "fill_2" },
        { "id": "spectrum-3", "type": "row", "children": [], "background": "fill_3" },
        { "id": "spectrum-4", "type": "row", "children": [], "background": "fill_4" },
        { "id": "spectrum-5", "type": "row", "children": [], "background": "fill_5" },
        { "id": "spectrum-6", "type": "row", "children": [], "background": "fill_6" }
      ]
    },
    {
      "id": "body",
      "type": "row",
      "resizable": false,
      "divider": {
        "width": 3,
        "color": "border"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "lisa-workspace-chrome"
              },
              "size": {
                "px": 52
              },
              "window_drag": true
            },
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "lisa-spaces"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "lisa-agents"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "lisa-workspace-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 69
              }
            }
          ],
          "size": {
            "px": 268
          },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "lisa-tabs"
              },
              "size": {
                "px": 48
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "lisa-pane"
                        },
                        "reveal": "always",
                        "height": 34,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 3,
                        "color": "border"
                      },
                      "focus": {
                        "width": 3,
                        "color": "ring"
                      },
                      "radius": 14,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 8,
              "gap": 8
            },
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "lisa-workspace-status"
              },
              "size": {
                "px": 32
              }
            }
          ],
          "resizable": false
        }
      ]
    }
  ],
  "background": "canvas",
  "theme": "lisa-day",
  "font": "Comic Mono",
  "font_size": 14,
  "ui_font": "Fredoka",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    32
  ]
}
